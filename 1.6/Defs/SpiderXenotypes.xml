      <li>FireWeakness</li>
      <li>Immunity_Weak</li>
      <li>MoveSpeed_VeryQuick</li>
      <li>NakedSpeed</li>
      <li>Aggression_HyperAggressive</li>
      <li>KillThirst</li>
      <li>Mood_Pessimist</li>
      <li>MinTemp_SmallDecrease</li>
      <li>MaxTemp_SmallDecrease</li>
      <li>StrongStomach</li>
      <li>RobustDigestion</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_Diet_Carnivore</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_EverFertile</li>
