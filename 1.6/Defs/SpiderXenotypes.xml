      <li MayRequire="RedMattis.BigSmall.Core">BS_TrulyAgeless</li>
      <li MayRequire="RedMattis.BigSmall.Core">VU_NearSterile</li>
      <li MayRequire="sarg.alphagenes">AG_InsectBlood</li>
      <li MayRequire="vanillaracesexpanded.insector">VRE_InsectFlesh</li>
      <li>DZ_HemogenExpel</li>
    </genes>
  </XenotypeDef>
</Defs>
