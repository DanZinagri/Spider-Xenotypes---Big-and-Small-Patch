<?xml version="1.0" ?>
<Defs>
  <XenotypeDef>
    <defName>Arakron</defName>
    <label>Arakron</label>
    <description>A Brutish Arachne Xenotype that overhwelmes its foes with both strength and poison.</description>
    <descriptionShort>Brutish Arachne Xenotype</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/SpiderIcon</iconPath>
    <inheritable>true</inheritable>
    <genes>
      <li>ArchiteMetabolism</li>
      <li MayRequire="RedMattis.BigSmall.Core">LoS_VenomTalons</li>
      <li>Body_Standard</li>
      <li MayRequire="sarg.alphagenes">AG_InsectBlood</li>
      <li MayRequire="vanillaracesexpanded.insector">VRE_InsectFlesh</li>
      <li>StrongStomach</li>
      <li>RobustDigestion</li>
      <li>WoundHealing_Fast</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_NaturalArmor_Great</li>
      <li>PsychicAbility_Dull</li>
      <li>MoveSpeed_Slow</li>
      <li>ToxResist_Partial</li>
      <li>FireWeakness</li>
      <li>Aggression_HyperAggressive</li>
      <li>MeleeDamage_Strong</li>
      <li>KillThirst</li>
      <li MayRequire="sarg.alphagenes">AG_VenomFangs</li>
      <li>DarkVision</li>
      <li>Instability_Major</li>
      <li>AptitudeRemarkable_Melee</li>
      <li>AptitudePoor_Plants</li>
      <li>AptitudeStrong_Crafting</li>
      <li>DZ_SpiderBody_Arakron</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="euterpe.milkytitfuck">
    <defName>Nurserachne</defName>
    <label>Nurserachne</label>
    <description>A strange genetic experiment. Nuserachne are made to be a versitile wet nurse, as well as capable of helping carry young for others. This makes them a genetic dead-end unable to carry on their own genes without more cloning of their xenotype.</description>
    <descriptionShort>Easter Egg Xenotype</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/SpiderIcon</iconPath>
    <inheritable>true</inheritable>
    <genes>
      <li>ArchiteMetabolism</li>
      <li>Body_FemaleOnly</li>
      <li>SEX_MoreMilk</li>
      <li>SEX_AlwaysLactating</li>
      <li>Fertile</li>
      <li>Body_Standard</li>
      <li MayRequire="redmattis.bettergeneinheritance">BGI_RecessiveGenes</li>
      <li>Beauty_Beautiful</li>
      <li>AptitudeTerrible_Shooting</li>
      <li>AptitudeTerrible_Mining</li>
      <li>AptitudePoor_Plants</li>
      <li>AptitudeTerrible_Artistic</li>
      <li>AptitudeStrong_Medicine</li>
      <li>AptitudeStrong_Social</li>
      <li>BS_SpiderBody_Cloth</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_EndlessGrowth</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_SlowAging</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_EverFertile</li>
      <li MayRequire="sarg.alphagenes">AG_InsectBlood</li>
      <li MayRequire="vanillaracesexpanded.insector">VRE_InsectFlesh</li>
      <li MayRequire="sarg.alphaanimals">DZ_StunningWeb</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="dankpyon.medieval.overhaul">
    <defName>SilkWeaver</defName>
    <label>Silk Weaver</label>
    <description>A human spider hybrid that excels at crafting and produces their own high quality silk.</description>
    <descriptionShort>Silk producing spider</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/SpiderIcon</iconPath>
    <inheritable>true</inheritable>
    <genes>
      <li>TotalHealing</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_NaturalArmor</li>
      <li>Moth_floof_HairClr</li>
      <li MayRequire="RedMattis.BigSmall.Core">VU_Pounce</li>
      <li>StrongStomach</li>
      <li>RobustDigestion</li>
      <li>Immunity_Weak</li>
      <li>WoundHealing_Fast</li>
      <li>Mood_Depressive</li>
      <li>MinTemp_SmallIncrease</li>
      <li>ToxResist_Partial</li>
      <li>Delicate</li>
      <li>DarkVision</li>
      <li>Instability_Major</li>
      <li>ElongatedFingers</li>
      <li>AptitudePoor_Plants</li>
      <li>AptitudeTerrible_Animals</li>
      <li>AptitudeRemarkable_Crafting</li>
      <li>BS_SpiderBody_Silk</li>
      <li>Body_Standard</li>
      <li MayRequire="sarg.alphagenes">AG_InsectBlood</li>
      <li MayRequire="vanillaracesexpanded.insector">VRE_InsectFlesh</li>
      <li MayRequire="sarg.alphaanimals">DZ_StunningWeb</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef>
