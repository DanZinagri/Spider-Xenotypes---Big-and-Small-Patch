<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <AbilityDef MayRequire="sarg.alphaanimals">
        <defName>DZ_StunningWeb</defName>
        <label>stunning web</label>
        <description>Throw a web of sticky silk that can stun its target, just like a feralisk.</description>
        <iconPath>UI/Abilities/AA_Web</iconPath>
        <cooldownTicksRange>2500</cooldownTicksRange>
        <aiCanUse>true</aiCanUse>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <writeCombatLog>True</writeCombatLog>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>25</range>
            <warmupTime>3</warmupTime>
            <soundCast>AA_ThrowShort</soundCast>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>AA_Web</projectileDef>
            </li>
        </comps>
    </AbilityDef>

